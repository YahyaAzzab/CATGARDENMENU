# Copier ce fichier vers .env.local, puis coller les valeurs.
# Supabase → Project Settings → API
#
# VITE_SUPABASE_URL          Project URL
# VITE_SUPABASE_ANON_KEY     clé anon / public
#
# La clé service_role ne va pas ici : elle ne doit jamais commencer par VITE_.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
