# Copier ce fichier vers .env.local, puis coller les valeurs.
# Supabase → Project Settings → API
#
# VITE_SUPABASE_URL          Project URL
# VITE_SUPABASE_ANON_KEY     clé anon / publishable (sb_publishable_…)
#
# Sur Vercel, ces deux noms exacts doivent être cochés pour Production.
# La valeur est seulement l’adresse ou la clé, sans guillemets.
# Puis il faut un nouveau déploiement : Vite les grave au moment du build.
#
# La clé service_role ne va pas ici : elle ne doit jamais commencer par VITE_.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
